/**
 *
 * 	VersionInfo.rc - Product version info resource script file
 *
 */

#pragma code_page(65001)

#include <windows.h>
#include "../include/Version.h"

// Version information
VS_VERSION_INFO 	VERSIONINFO
 FILEVERSION 		DW_VERSION_FILE_DIGITAL_VALUE
 PRODUCTVERSION 	DW_VERSION_PRODUCT_DIGITAL_VALUE
 FILEFLAGSMASK 		0x3fL
 FILEFLAGS 			0x0L
 FILEOS 			VOS_NT_WINDOWS32
 FILETYPE 			VFT_STATIC_LIB
 FILESUBTYPE 		VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", 		DW_VERSION_COMPANY_NAME
            VALUE "FileDescription", 	DW_VERSION_FILE_DESCRIPTION
            VALUE "FileVersion", 		DW_VERSION_FILE_VALUE
            VALUE "InternalName", 		DW_VERSION_INTERNAL_NAME
            VALUE "LegalCopyright", 	DW_VERSION_LEGAL_COPYRIGHT
            VALUE "OriginalFilename", 	DW_VERSION_INTERNAL_NAME
            VALUE "ProductName", 		DW_VERSION_PRODUCT_NAME
            VALUE "ProductVersion", 	DW_VERSION_PRODUCT_VALUE
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

